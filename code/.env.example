# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Optional: route scheduled reports into a specific forum topic (message_thread_id)
TELEGRAM_REPORTS_TOPIC_ID=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Repo the bot reads GTM data from (public repo, no token needed) ---
GITHUB_REPO=tnsaruniitr-lab/growthmonk-gtm
# Branch holding the GTM data files. Use the feature branch until it is merged to main.
GITHUB_BRANCH=main

# --- Google Sheets (read-only, OAuth refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SHEET_ID=

# --- Leads API: client 1 ---
LEADS_API_BASE=https://growthmonk.ai
LEADS_API_SLUG=carecompass
LEADS_CLIENT_NAME=CareCompass
LEADS_API_KEY=

# --- Leads API: client 2 (optional — leave LEADS_API_KEY_2 blank to disable) ---
# LEADS_API_BASE_2 is optional; falls back to LEADS_API_BASE when unset
LEADS_API_BASE_2=
LEADS_API_SLUG_2=growthmonk
LEADS_CLIENT_NAME_2=GrowthMonk
LEADS_API_KEY_2=

# More brands: add LEADS_API_KEY_3 / _SLUG_3 / _NAME_3 … up to _10
LEADS_CRON=0 */2 * * *

# --- Scheduling ---
TIMEZONE=Asia/Dubai
DAILY_CRON=0 9 * * *
WEEKLY_CRON=0 9 * * 1
EMAIL_CRON=0 */2 * * *
EMAIL_WINDOW_HOURS=3

# Health-check port (Railway injects this automatically)
PORT=3000
